.claude/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# Large local artefacts: raw images, cached features, checkpoints and run outputs
data/
features/
runs/
*.pt
# ...except the few linear-probe heads the configs start fine-tuning from (~1 MB each),
# which Colab needs from the git checkout
!heads/*.pt
*.pth
*.safetensors
*.npz

# ============================================================================
# Kept on this machine only. The public repository holds the training pipeline (data preparation,
# backbone screening, fine-tuning, evaluation, ablations), its configs and the logs of the reported
# runs; everything below stays local.
# ============================================================================

# IDE settings, notes, the report, the slides, and the web app (published on Hugging Face)
/.idea/
/.run/
/app/
/docs/
/out/
/presentation/
/report/

